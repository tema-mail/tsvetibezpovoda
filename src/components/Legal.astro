---
// Юридическая страница: текст с донора, разделы уже размечены заголовками в src/data/legal.json.
import Base from '../layouts/Base.astro';
import Crumbs from './Crumbs.astro';
import legal from '../data/legal.json';
import { SITE } from '../lib/site';
const { doc, title } = Astro.props as { doc: 'privacy' | 'agreement'; title: string };
---
<Base title={`${title} – ${SITE.name}`} description={`${title} сайта цветочного салона «${SITE.name}» (${SITE.city}).`}>
  <article class="container legal">
    <Crumbs items={[{ label: 'Главная', href: '/' }, { label: title }]} />
    <h1 class="h1">{legal[doc].title}</h1>
    <div class="legal__body" set:html={legal[doc].html} />
  </article>
</Base>
<style>
  .legal { max-width: 960px; padding-top: 24px; display: grid; gap: 24px; }
  .legal__body { font-size: 15px; line-height: 1.7; color: var(--ink); }
  .legal__body :global(h2) { font: 500 24px/1.25 var(--head-font); color: var(--mauve); margin: 36px 0 12px; }
  .legal__body :global(p) { margin: 0 0 6px; }
  .legal__body :global(a) { text-decoration: underline; word-break: break-all; }
</style>
