---
// «Доставка цветов по Курску» – 4 карточки с условиями донора, для главной и каталога.
import IconCards from './IconCards.astro';
import { DELIVERY_FROM, FREE_FROM } from '../lib/delivery';
const n = (x: number) => x.toLocaleString('ru-RU');
---
<IconCards
  title="Доставка цветов по Курску"
  sub="Ежедневно с 10:00 до 00:00 – личной курьерской службой."
  action={{ label: 'Подробнее о доставке и оплате', href: '/delivery' }}
  items={[
    { title: 'За 60 минут', text: 'Доставим по Курску в течение 60 минут с момента оплаты. Удалённые районы – чуть дольше.' },
    { title: `От ${n(DELIVERY_FROM)} ₽`, text: 'Стоимость рассчитывается индивидуально в зависимости от района доставки.' },
    { title: `Бесплатно от ${n(FREE_FROM)} ₽`, text: `При заказе от ${n(FREE_FROM)} ₽ доставка по Курску бесплатная.` },
    { title: 'Подарки к заказу', text: 'К каждому заказу – открытка и средство по уходу за букетом.' },
  ]}
/>
