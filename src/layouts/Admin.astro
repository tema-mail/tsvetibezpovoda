---
/** Каркас кабинета-стандарта (перенос с Milovini ac14c0e): шапка и вкладки как у Elite Rose / ALEX KROWN v1, адрес сайта
    справа, «Выйти». Весь кабинет закрыт логином и паролем (scripts/lock-admin.mjs при публикации). Закрыт от поиска.
    Стадия 1 (владелец 27.10.2026): только «Страницы сайта» (списком, без карточек страниц) и «Заявки» –
    остальных вкладок стандарта нет совсем, не замками. */
import '../styles/admin.css';
import { u } from '../lib/url';
type Tab = 'pages' | 'leads';
interface Props { title: string; active: Tab }
const { title, active } = Astro.props;
const site = new URL(u('/'), Astro.site).href;
const tabs: [Tab, string, string][] = [
  ['pages', '/admin/', 'Страницы сайта'],
  ['leads', '/admin/leads/', 'Заявки'],
];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} – админка «Цветы без повода»</title>
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body class="adm">
    <nav class="topnav" aria-label="Разделы админки">
      <span class="brand"><img src={u('/favicon.png')} alt="" />ЦВЕТЫ БЕЗ ПОВОДА</span>
      {tabs.map(([key, href, label]) => (
        <a class:list={['tab', { on: active === key }]} href={u(href)}>{label}</a>
      ))}
      <span class="site">Сайт: <a href={site} target="_blank" rel="noopener">{site.replace(/^https?:\/\//, '')}</a></span>
      {/* выход из кабинета (вход – scripts/lock-admin.mjs), стирает оба входа – как «Выйти» у EV / ALEX KROWN */}
      <button type="button" class="logout" onclick="try{sessionStorage.removeItem('tbp_admin_auth');localStorage.removeItem('tbp_admin_keep')}catch(e){};location.reload()" style="background:none;border:0;color:rgba(255,255,255,.75);font:inherit;font-size:13px;cursor:pointer;padding:0">Выйти</button>
    </nav>
    <main><slot /></main>
  </body>
</html>
