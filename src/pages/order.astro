---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Order from '../islands/Order';
import { products, toCard, inPart, addonParts } from '../lib/catalog';

// Допродажа – товары разделов addonParts (у донора таких нет, блок не показывается).
const addons = products.filter((p) => p.price && p.images.length && addonParts.some((id) => inPart(p, id))).map(toCard);
---
<Base title="Оформление заказа – Цветы без повода" noindex noSticky>
  <section class="container" style="padding-top:24px;display:grid;gap:20px">
    <Crumbs items={[{ label: 'Главная', href: '/' }, { label: 'Каталог', href: '/catalog' }, { label: 'Оформление заказа' }]} />
    <h1 class="h1">Оформление заказа</h1>
    <Order client:load addons={addons} />
  </section>
</Base>
