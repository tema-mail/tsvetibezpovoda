---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import CatalogLinks from '../../components/CatalogLinks.astro';
import DeliveryCards from '../../components/DeliveryCards.astro';
import FinalCta from '../../components/FinalCta.astro';
import ContactCard from '../../components/ContactCard.astro';
import Catalog from '../../islands/Catalog';
import { products, toCard, allChips } from '../../lib/catalog';
import { SITE } from '../../lib/site';

const all = products.filter((p) => p.price && p.images.length).map(toCard);
const min = Math.min(...all.map((x) => x.price));
---
<Base title={`Каталог букетов с доставкой по Курску – ${SITE.name}`} description={`Каталог «${SITE.name}»: ${all.length} букетов от ${min.toLocaleString('ru-RU')} ₽ – сборные, монобукеты, композиции, премиум, розы и хризантемы. Доставка по Курску за 60 минут.`}>
  <PageHero
    small
    crumbs={[{ label: 'Главная', href: '/' }, { label: 'Каталог' }]}
    title="Каталог букетов"
    text="Сборные букеты, монобукеты, композиции, премиум, хиты и акции. Доставим по Курску за 60 минут, открытка и средство по уходу – в подарок."
    image={products[5].images[0]}
    buttons={[{ label: 'Выбрать букет', href: '/catalog#list' }, { label: 'Помогите выбрать', lead: true }]}
    features
  />
  <section class="section container" id="list">
    <SectionHead title="Все букеты" sub={`${all.length} букетов от ${min.toLocaleString('ru-RU')} ₽`} />
    <CatalogLinks />
    <Catalog client:load cards={all} chips={allChips()} step={16} />
  </section>
  <DeliveryCards />
  <FinalCta />
  <ContactCard />
</Base>
