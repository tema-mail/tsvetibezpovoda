---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import CatalogLinks from '../../components/CatalogLinks.astro';
import FinalCta from '../../components/FinalCta.astro';
import ContactCard from '../../components/ContactCard.astro';
import Catalog from '../../islands/Catalog';
import { CATALOGS, SITE } from '../../lib/site';
import { products } from '../../lib/catalog';
import { catalogCards, chip, partById } from '../../lib/catalog';

export function getStaticPaths() {
  return CATALOGS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: (typeof CATALOGS)[number] };
const cards = catalogCards(c.part);
const part = partById.get(c.part);
// У раздела есть подразделы (Композиции → корзины, коробки) – показываем их чипами.
const chips = part && part.children.length ? part.children.map((x) => chip(x.id, undefined, false)) : undefined;
const min = Math.min(...cards.map((x) => x.price));
const desc = `${c.h1}: ${cards.length} вариантов от ${min.toLocaleString('ru-RU')} ₽. Доставка по Курску за 60 минут, открытка и средство по уходу в подарок.`;
// Фото первого экрана – первый товар раздела.
const image = products.find((p) => p.parts.includes(c.part) && p.images.length)!.images[0];
---
<Base title={`${c.h1} – ${SITE.name}`} description={desc}>
  <PageHero
    small
    crumbs={[{ label: 'Главная', href: '/' }, { label: 'Каталог', href: '/catalog' }, { label: c.crumb }]}
    title={c.h1}
    text={c.text}
    image={image}
    buttons={[{ label: 'Смотреть букеты', href: `/catalog/${c.slug}#list` }, { label: 'Помогите выбрать', lead: true }]}
  />
  <section class="section container" id="list">
    <SectionHead title={c.heading} sub={`С доставкой по Курску – ${cards.length} шт., от ${min.toLocaleString('ru-RU')} ₽`} />
    <CatalogLinks current={c.slug} />
    <Catalog client:load cards={cards} chips={chips} step={16} />
  </section>
  <FinalCta />
  <ContactCard />
</Base>
