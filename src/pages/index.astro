---
// Главная: структура Milovini, содержимое – с tsvetibezpovoda.ru (у донора главная = каталог).
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CatalogLinks from '../components/CatalogLinks.astro';
import DeliveryCards from '../components/DeliveryCards.astro';
import FinalCta from '../components/FinalCta.astro';
import ContactCard from '../components/ContactCard.astro';
import Catalog from '../islands/Catalog';
import { products, toCard, inPart, allChips, PART } from '../lib/catalog';
import { SITE } from '../lib/site';

const all = products.filter((p) => p.price && p.images.length).map(toCard);
const hits = products.filter((p) => inPart(p, PART.hits) && p.images.length).map(toCard);
---
<Base title={`Цветы с доставкой в Курске за 60 минут – ${SITE.name}`} description={`Цветочный салон «${SITE.name}» в Курске: ${all.length} букетов – сборные, монобукеты, композиции, премиум. Доставка за 60 минут, открытка и средство по уходу в подарок.`}>
  <PageHero
    badge="Цветочный салон в Курске"
    title="Цветы без повода"
    accent="за 60 минут"
    text={`Сборные букеты, монобукеты, композиции и премиум-букеты с доставкой по Курску. К каждому заказу – открытка и средство по уходу за букетом в подарок.`}
    image={products[1].images[0]}
    buttons={[{ label: 'Выбрать букет', href: '/#catalog' }, { label: 'Помогите выбрать', lead: true }]}
    features
  />

  <section class="section container" id="catalog">
    <SectionHead title="Каталог букетов" action={{ label: 'Смотреть весь каталог', href: '/catalog', variant: 'outline' }} />
    <CatalogLinks />
    <Catalog client:visible cards={all} chips={allChips()} step={12} />
  </section>

  {hits.length > 0 && (
    <section class="section container">
      <SectionHead title="Хиты" sub="Букеты, которые выбирают чаще всего" action={{ label: 'Все хиты', href: '/catalog/hity', variant: 'outline' }} />
      <Catalog client:visible cards={hits} step={8} prices={false} sort={false} />
    </section>
  )}

  <DeliveryCards />
  <FinalCta />
  <ContactCard />
</Base>
