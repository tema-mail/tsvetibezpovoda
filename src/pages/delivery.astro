---
// Доставка и оплата – тексты со страницы /delivery донора (27.10.2026).
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import FinalCta from '../components/FinalCta.astro';
import ContactCard from '../components/ContactCard.astro';
import { DELIVERY_FROM, FREE_FROM } from '../lib/delivery';
import { SITE } from '../lib/site';
import { products } from '../lib/catalog';
const n = (x: number) => x.toLocaleString('ru-RU');
const cards = [
  { title: 'Условия доставки', items: ['Доставка осуществляется ежедневно с 10:00 до 00:00.', 'Время доставки по Курску – в течение 60 минут с момента оплаты заказа. Заказы в удалённые районы могут занимать больше времени.'] },
  { title: 'Стоимость доставки', items: ['Доставка осуществляется личной курьерской службой.', `Стоимость доставки по Курску – от ${n(DELIVERY_FROM)} ₽, рассчитывается индивидуально в зависимости от района доставки.`, `Бесплатная доставка по Курску при заказе от ${n(FREE_FROM)} ₽.`] },
  { title: 'Способы оплаты', items: ['Наличными при самовывозе в нашей студии.', 'Переводом после подтверждения заказа.'] },
];
---
<Base title={`Доставка и оплата цветов в Курске – ${SITE.name}`} description={`Доставка цветов по Курску ежедневно с 10:00 до 00:00 за 60 минут после оплаты. От ${n(DELIVERY_FROM)} ₽, бесплатно от ${n(FREE_FROM)} ₽. Оплата переводом или наличными при самовывозе.`}>
  <PageHero
    small
    crumbs={[{ label: 'Главная', href: '/' }, { label: 'Доставка и оплата' }]}
    title="Доставка и оплата"
    text={`Доставляем по Курску ежедневно с 10:00 до 00:00 – в течение 60 минут с момента оплаты. Бесплатно при заказе от ${n(FREE_FROM)} ₽.`}
    image={products[3].images[0]}
    buttons={[{ label: 'Выбрать букет', href: '/catalog' }, { label: 'Помогите выбрать', lead: true }]}
  />
  <section class="section container">
    <SectionHead title="Условия" sub={`Остались вопросы по доставке – позвоните: ${SITE.phone}`} />
    <div class="dt">
      {cards.map((c) => (
        <article class="dt__card">
          <h3 class="h3">{c.title}</h3>
          <ul>{c.items.map((i) => <li>{i}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>
  <FinalCta />
  <ContactCard />
</Base>
<style>
  .dt { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .dt__card { display: flex; flex-direction: column; gap: 14px; padding: 28px; border: 1px solid var(--mauve); border-radius: var(--radius-l); font-size: 15px; }
  .dt__card ul { margin: 0; padding-left: 18px; display: grid; gap: 8px; color: var(--ink); }
  @media (max-width: 1023px) {
    .dt { grid-template-columns: 1fr; gap: 10px; }
    .dt__card { padding: 20px; }
  }
</style>
